# Copy this file to .env to override defaults
# cp .env.example .env

# Change this in production!
SECRET_KEY=django-insecure-change-me-in-production

# Set to False in production
DEBUG=False

# Comma-separated. Use * to allow all (development only)
ALLOWED_HOSTS=*

# Host port the API is available on
PORT=8000

# Redis — no need to change when using docker compose
REDIS_HOST=redis
REDIS_PORT=6379

# Optional: Anthropic API key for AI-powered content moderation (Stage 3)
# Leave blank to disable the AI stage — the pipeline still works without it
ANTHROPIC_API_KEY=

# Optional: Claude model used for AI moderation (default: claude-opus-4-8)
# AI_MODEL=claude-haiku-4-5
